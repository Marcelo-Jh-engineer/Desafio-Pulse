# ---------------------------------------------------------------
# Ferramental de agente (Claude Code)
# ---------------------------------------------------------------
# Configuracao do agente e por maquina, nao do projeto: skill instalada,
# preferencia local, plano, transcricao de sessao. Nada disso descreve o
# sistema, e a transcricao ainda carrega caminho absoluto da maquina.
.claude/
**/.claude/

# Outros agentes / assistentes
.cursor/
.aider*
.windsurfrules
.vscode/
