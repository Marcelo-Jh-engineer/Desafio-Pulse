# ---------------------------------------------------------------
# Ferramental de agente (Claude Code)
# ---------------------------------------------------------------
# Skills sao instaladas por maquina/usuario, nao fazem parte do projeto.
.claude/skills/
**/.claude/skills/

# Preferencias locais de cada dev. O settings.json compartilhado fica versionado.
.claude/settings.local.json
**/.claude/settings.local.json
.claude/*.local.json
.claude/plans/
.claude/todos/
.claude/shell-snapshots/
.claude/statsig/
.claude/projects/

# Outros agentes / assistentes
.cursor/
.aider*
.windsurfrules

# ---------------------------------------------------------------
# Node / frontend
# ---------------------------------------------------------------
node_modules/
dist/
dist-ssr/
build/
coverage/
.vite/
*.tsbuildinfo
.eslintcache
.npm/

# ---------------------------------------------------------------
# Ambiente — segredo nunca vai para o repositorio
# ---------------------------------------------------------------
# .env.example, .env.development e .env.production sao versionados de proposito:
# nao contem segredo, so VITE_API_MODE e VITE_API_BASE_URL.
.env.local
.env.*.local
*.pem
*.key

# ---------------------------------------------------------------
# Java / Spring Boot (pasta Back)
# ---------------------------------------------------------------
target/
!.mvn/wrapper/maven-wrapper.jar
.gradle/
*.class
*.war
*.ear
hs_err_pid*
replay_pid*

# ---------------------------------------------------------------
# Logs
# ---------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------
# Editor
# ---------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------------------------------------------------------------
# Sistema operacional
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*~
