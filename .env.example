# Variaveis do banco. Consumidas pelo docker compose e pelo Spring Boot.
# Modelo versionado. Copie para .env e ajuste os valores:
#   cp .env.example .env

POSTGRES_DB=ecommerce
DB_USER=postgres
DB_PASSWORD=troque-esta-senha
DB_PORT=5440

# Lida por Back/ecommerce/src/main/resources/application.properties.
DB_URL=jdbc:postgresql://localhost:5440/ecommerce

# Porta do backend Spring.
SERVER_PORT=8080

# ---------------------------------------------------------------
# Keycloak (identidade)
# ---------------------------------------------------------------
KEYCLOAK_PORT=8081
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_REALM=ecommerce
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=troque-esta-senha
