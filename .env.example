# Variaveis do banco. Consumidas pelo docker compose e pelo Spring Boot.
# Modelo versionado. Copie para .env e ajuste os valores:
#   cp .env.example .env

POSTGRES_DB=ecommerce
DB_USER=postgres
DB_PASSWORD=troque-esta-senha
DB_PORT=5440

# Endereco do banco para o backend rodando FORA do compose (mvnw spring-boot:run).
# Dentro do compose este valor e ignorado: o container fala com o servico `banco`
# pela rede interna, onde localhost seria o proprio container.
DB_URL=jdbc:postgresql://localhost:${DB_PORT}/${POSTGRES_DB}

# Porta do backend Spring.
SERVER_PORT=8080

# Porta da SPA servida pelo nginx no docker compose. Nao e 5173 de proposito:
# assim o container e o `npm run dev` podem rodar ao mesmo tempo.
FRONT_PORT=3000

# ---------------------------------------------------------------
# Keycloak (identidade)
# ---------------------------------------------------------------
KEYCLOAK_PORT=8081
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_REALM=ecommerce
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=troque-esta-senha
# O client-secret precisa ser IDENTICO ao campo "secret" do client
# ecommerce-api em docker/keycloak/realm-ecommerce.json: o realm e importado com
# esse valor gravado, e o backend se autentica com o que estiver aqui.
KEYCLOAK_CLIENT_ID=ecommerce-api
KEYCLOAK_CLIENT_SECRET=troque-este-segredo

# Origens do SPA aceitas pelo CORS da API. Sao duas porque a SPA tem dois
# enderecos: no compose o nginx a serve na FRONT_PORT, e fora dele o Vite sobe
# na 5173. Lista separada por virgula, sem espaco e sem barra no fim.
URL_DO_FRONT=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------
# RabbitMQ (mensageria)
# ---------------------------------------------------------------
# Credenciais ficam aqui, e nao no compose: gravadas no compose elas apareceriam
# em `docker history` e no repositorio.
RABBITMQ_USER=pulse
RABBITMQ_PASS=troque-esta-senha
# Painel de administracao em http://localhost:15672 — e por ele que se confere
# fila, binding e DLQ. A porta AMQP (5672) nao e publicada: so o backend fala
# com o broker, pela rede interna do compose.
RABBITMQ_PAINEL_PORT=15672

# Host do broker para o backend rodando FORA do compose. Dentro dele o valor e
# ignorado: o container fala com o servico `broker`.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# ---------------------------------------------------------------
# Comportamento do proprio docker compose
# ---------------------------------------------------------------
# Desliga o delegador "bake" do Compose. Ligado, ele termina o build e depois
# falha ao ler o resultado — `failed to execute bake: read |0: file already
# closed`. As imagens ficam prontas, mas o comando sai com erro e nao sobe nada.
# Sem bake o Compose chama o builder direto, que funciona.
COMPOSE_BAKE=false
